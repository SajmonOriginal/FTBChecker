{
  "schemaVersion": 1,
  "id": "ftbchecker",
  "version": "${version}",
  "name": "FTBChecker",
  "description": "Checks for required mods on startup and shows download links for any that are missing. Pre-configured with FTB mods but can check for any mod.",
  "authors": [
    "SajmonOriginal"
  ],
  "contact": {
    "homepage": "https://github.com/SajmonOriginal/FTBChecker",
    "sources": "https://github.com/SajmonOriginal/FTBChecker"
  },
  "license": "MIT",
  "icon": "assets/ftbchecker/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.sajmonoriginal.ftbchecker.FTBCheckerClient"
    ],
    "modmenu": [
      "com.sajmonoriginal.ftbchecker.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.14.0",
    "minecraft": "~1.19.2",
    "java": ">=17",
    "fabric-api": "*",
    "cloth-config": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
