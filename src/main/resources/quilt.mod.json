{
  "schema_version": 1,
  "quilt_loader": {
    "group": "${group}",
    "id": "ftbchecker",
    "version": "${version}",
    "metadata": {
      "name": "FTBChecker",
      "description": "Ensures the presence of FTB mods in your modpack. Displays download links for missing mods.",
      "contributors": {
        "SajmonOriginal": "Developer",
        "RedstoneWizard08": "Developer"
      },
      "contact": {
        "homepage": "https://github.com/SajmonOriginal/FTBChecker",
        "sources": "https://github.com/SajmonOriginal/FTBChecker"
      },
      "icon": "assets/ftbchecker/icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "client_init": [
        "com.sajmonoriginal.ftbchecker.FTBCheckerClient"
      ],
      "modmenu": [
        "com.sajmonoriginal.ftbchecker.ModMenuIntegration"
      ]
    },
    "depends": [
      {
        "id": "quilt_loader",
        "versions": ">=0.19.0"
      },
      {
        "id": "quilt_base",
        "versions": "*"
      },
      {
        "id": "minecraft",
        "versions": "~1.21"
      },
      {
        "id": "java",
        "versions": ">=21"
      }
    ]
  },
  "mixin": "ftbchecker.mixins.json"
}
